<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:padding="6dp"
        android:layout_marginTop="15dp"
        android:layout_height="50dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số thứ nhất"
            android:textSize="18dp"
            android:textColor="#987"/>
        <EditText
            android:id="@+id/edtSo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:padding="6dp"
        android:layout_marginTop="15dp"
        android:layout_height="50dp">
        <TextView
            android:paddingRight="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số thứ hai"
            android:textSize="18sp"
            android:textColor="#987"/>
        <EditText
            android:id="@+id/edtSo2"
            android:layout_marginBottom="4.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_marginVertical="23.4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:padding="6dp"
        android:layout_marginTop="15dp"
        android:layout_height="50dp">

        <Button
            android:id="@+id/btnCong"
            android:layout_width="55dp"
            android:layout_height="94dp"
            android:layout_marginHorizontal="15dp"
            android:text="+" />
        <Button
            android:id="@+id/btnTru"
            android:layout_marginHorizontal="15dp"
            android:layout_width="55dp"
            android:layout_height="94dp"
            android:text="-"/>
        <Button
            android:id="@+id/btnNhan"
            android:layout_marginHorizontal="15dp"
            android:layout_width="55dp"
            android:layout_height="94dp"
            android:text="*"/>
        <Button
            android:id="@+id/btnChia"
            android:layout_marginHorizontal="15dp"
            android:layout_width="55dp"
            android:layout_height="94dp"
            android:text="/"/>

    </LinearLayout>

    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:padding="6dp"
        android:layout_height="50dp">

        <TextView
            android:background="#E6A6B9"
            android:textSize="20dp"
            android:padding="10dp"
            android:id="@+id/tvKetQua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="Kết quả" />
    </LinearLayout>

</LinearLayout>